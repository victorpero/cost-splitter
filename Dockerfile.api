# syntax=docker/dockerfile:1

FROM golang:1.22-alpine AS build

WORKDIR /src
COPY go.mod ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/cost-splitter-api ./cmd/cost-splitter-api

FROM alpine:3.20

LABEL org.opencontainers.image.source="https://github.com/victorpero/cost-splitter"

RUN addgroup -S -g 1000 app && adduser -S -D -H -u 1000 -G app app

COPY --from=build /out/cost-splitter-api /usr/local/bin/cost-splitter-api

ENV API_ADDR=0.0.0.0:8080 \
    API_CURRENCY=SEK \
    API_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

USER 1000:1000
EXPOSE 8080

ENTRYPOINT ["cost-splitter-api"]
